{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Storycraft",
  "version": "0.1.0",
  "identifier": "dev.openstorycraft.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Storycraft",
        "width": 420,
        "height": 780,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "resources": {
      "../../open-storycraft": "skills"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
