{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Storycraft",
  "version": "0.1.0",
  "identifier": "dev.openstorycraft.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Storycraft",
        "width": 980,
        "height": 700,
        "minWidth": 380,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "resources": {
      "../../open-storycraft": "skills"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
